<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:SportClub.Maui.Services"
             xmlns:vm="clr-namespace:SportClub.Maui.ViewModels"
             x:Class="SportClub.Maui.Views.SessionDetailPage"
             x:DataType="vm:SessionDetailViewModel"
             Title="Treening"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Ground}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <!-- Dark header -->
                <Border BackgroundColor="{DynamicResource Panel}" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,28,28" Padding="20,28,20,28">
                    <VerticalStackLayout Spacing="16">
                        <Button Text="{loc:T back}" Command="{Binding BackCommand}" HorizontalOptions="Start" BackgroundColor="#262A30"
                                TextColor="{StaticResource OnPanel}" CornerRadius="12" HeightRequest="40" Padding="14,0" FontFamily="OpenSansSemibold" />
                        <Border BackgroundColor="{Binding Session.BadgeBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                Padding="12,6" HorizontalOptions="Start">
                            <Label Text="{Binding Session.Badge}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{Binding Session.BadgeTextColor}" />
                        </Border>
                        <Label Text="{Binding Session.Name}" FontFamily="OpenSansSemibold" FontSize="36" TextColor="{StaticResource OnPanel}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <VerticalStackLayout>
                                <Label Text="{loc:T detail.time}" FontSize="12" TextColor="#9EA4AD" />
                                <Label Text="{Binding When}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource OnPanel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{loc:T detail.spots}" FontSize="12" TextColor="#9EA4AD" />
                                <Label Text="{Binding Session.CapacityText}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource OnPanel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1">
                                <Label Text="{loc:T detail.trainer}" FontSize="12" TextColor="#9EA4AD" />
                                <Label Text="{Binding Session.Trainer}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource OnPanel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="{loc:T detail.duration}" FontSize="12" TextColor="#9EA4AD" />
                                <Label Text="{Binding Session.Duration}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource OnPanel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Padding="20" Spacing="14">
                    <Border Style="{StaticResource Card}" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label VerticalOptions="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Session.FreeSpots}" FontFamily="OpenSansSemibold" FontSize="28" TextColor="{DynamicResource Ink}" />
                                            <Span Text="{loc:T detail.free}" FontSize="16" TextColor="{DynamicResource Muted}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Column="1" Text="{Binding Session.BookedLabel}" FontSize="13"
                                       TextColor="{DynamicResource Muted}" VerticalOptions="End" />
                            </Grid>
                            <ProgressBar Progress="{Binding Progress}" ProgressColor="{DynamicResource Ink}" HeightRequest="10" />
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Fill="#1F8A4C" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                <Label Text="{loc:T detail.live}" FontSize="12" TextColor="{DynamicResource Ink2}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding PassInfo}" FontSize="14" TextColor="{DynamicResource Ink2}" />
                            <Button Text="{loc:T detail.buyPass}" Command="{Binding BuyPassCommand}" Style="{StaticResource DarkButton}"
                                    HeightRequest="48" FontSize="15" IsVisible="{Binding HasNoPass}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,14" IsVisible="{Binding Session.IsFull}" BackgroundColor="{DynamicResource Panel}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:T detail.howTitle}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource OnPanel}" />
                            <Label Text="{loc:T detail.howText}"
                                   FontSize="14" TextColor="#C9CDD3" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="20,8,20,28" Spacing="10">
            <Label Text="{Binding BookedLabel}" IsVisible="{Binding IsBooked}" HorizontalTextAlignment="Center"
                   FontFamily="OpenSansSemibold" TextColor="{DynamicResource OkText}" />
            <Grid IsVisible="{Binding IsNotBusy}">
                <Button Text="{loc:T detail.book}" Command="{Binding BookCommand}" Style="{StaticResource AccentButton}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Session.IsFull}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBooked}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="{loc:T detail.waitlist}" Command="{Binding JoinWaitlistCommand}" Style="{StaticResource DarkButton}"
                        IsVisible="{Binding Session.IsFull}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBooked}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Ink}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
