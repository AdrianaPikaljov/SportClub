<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:SportClub.Maui.Services"
             xmlns:views="clr-namespace:SportClub.Maui.Views"
             xmlns:vm="clr-namespace:SportClub.Maui.ViewModels"
             x:Class="SportClub.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Panel}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="28,64,28,40" RowSpacing="0">

        <Grid ColumnDefinitions="*,Auto">
        <HorizontalStackLayout Spacing="10">
            <Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" WidthRequest="44" HeightRequest="44"
                    StrokeShape="RoundRectangle 12">
                <Label Text="SC" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource OnAccent}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="SportClub" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource OnPanel}" VerticalOptions="Center" />
        </HorizontalStackLayout>
            <views:SettingsBar Grid.Column="1" VerticalOptions="Center" ShowTheme="False" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Margin="0,56,0,0" Spacing="14">
            <Label Text="{loc:T login.tagline}" FontFamily="OpenSansSemibold" FontSize="36" LineHeight="1.05"
                   TextColor="{StaticResource OnPanel}" />
            <Label Text="{loc:T login.text}"
                   FontSize="16" TextColor="#B7BCC4" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3" Spacing="12">
            <!-- Ainult telefonis: arvuti aadress, kus API töötab (start.bat näitab seda) -->
            <Label Text="{loc:T login.server}" FontSize="13" TextColor="#B7BCC4" IsVisible="{Binding ShowServer}" />
            <Border Style="{StaticResource DarkInput}" IsVisible="{Binding ShowServer}">
                <Entry Text="{Binding ServerUrl}" Keyboard="Url" TextColor="{StaticResource OnPanel}" Placeholder="http://192.168.1.15:5080"
                       PlaceholderColor="#6E747D" />
            </Border>
            <Label Text="{loc:T login.email}" FontSize="13" TextColor="#B7BCC4" />
            <Border Style="{StaticResource DarkInput}">
                <Entry Text="{Binding Email}" Keyboard="Email" TextColor="{StaticResource OnPanel}" Placeholder="nimi@example.com"
                       PlaceholderColor="#6E747D" />
            </Border>
            <Label Text="{loc:T login.password}" FontSize="13" TextColor="#B7BCC4" />
            <Border Style="{StaticResource DarkInput}">
                <Entry Text="{Binding Password}" IsPassword="True" TextColor="{StaticResource OnPanel}" ReturnCommand="{Binding LoginCommand}" />
            </Border>

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#FF9C70" FontSize="14" />

            <Button Text="{loc:T login.submit}" Command="{Binding LoginCommand}" Style="{StaticResource AccentButton}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" />
            <Button Text="{loc:T login.register}" Command="{Binding GoToRegisterCommand}" BackgroundColor="Transparent"
                    TextColor="{StaticResource OnPanel}" FontFamily="OpenSansSemibold" FontSize="14" HeightRequest="44" />
            <Label Text="Demo: klient@sportclub.ee / Klient123!  ·  treener@sportclub.ee / Treener123!"
                   FontSize="12" TextColor="#8E949D" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
