<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:SportClub.Maui.Services"
             xmlns:vm="clr-namespace:SportClub.Maui.ViewModels"
             x:Class="SportClub.Maui.Views.TrainerSessionsPage"
             x:DataType="vm:TrainerSessionsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Ground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,40,20,0" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="{Binding Greeting}" FontSize="14" TextColor="{DynamicResource Muted}" />
                <Label Text="{loc:T trainer.title}" Style="{StaticResource PageTitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{loc:T logout}" Command="{Binding LogoutCommand}" Style="{StaticResource OutlineButton}" VerticalOptions="End" />
        </Grid>

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />

        <!-- Next session -->
        <Border Grid.Row="2" BackgroundColor="{DynamicResource Panel}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20" IsVisible="{Binding HasNext}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding Next}" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="12">
                <Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="10,5" HorizontalOptions="Start">
                    <Label Text="{Binding NextLabel}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{StaticResource OnAccent}" />
                </Border>
                <Label FontFamily="OpenSansSemibold" FontSize="26" TextColor="{StaticResource OnPanel}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Next.Name}" />
                            <Span Text=" · " />
                            <Span Text="{Binding Next.Time}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label FontSize="14" TextColor="#B7BCC4">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Next.StatusText}" />
                            <Span Text=" · " />
                            <Span Text="{Binding Next.BookedText}" />
                            <Span Text="{loc:T trainer.participants}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Border BackgroundColor="{DynamicResource Ground}" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="48">
                    <Label Text="{loc:T trainer.mark}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{DynamicResource Ink}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="3" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True">
                <CollectionView.Header>
                    <!-- Hoiatus: toimunud treeningutel on märkimata osalejaid -->
                    <Border BackgroundColor="{DynamicResource FullBg}" Stroke="{DynamicResource FullText}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="14,12" Margin="0,4,0,4" IsVisible="{Binding HasUnmarked}">
                        <Label Text="{Binding UnmarkedText}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource FullText}" />
                    </Border>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Text="{loc:T trainer.empty}" TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center" Margin="0,30" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:SessionGroup">
                        <Label Text="{Binding Title}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{Binding TitleColor}" Margin="0,14,0,8" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionItem">
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10"
                                BackgroundColor="{Binding CardBackground}" Stroke="{Binding CardStroke}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainerSessionsViewModel}}, Path=OpenCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Day}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Muted}" />
                                    <Label Text="{Binding Time}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Ink}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Ink}" />
                                    <Label Text="{Binding StatusText}" FontSize="13" TextColor="{Binding StatusColor}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding BookedText}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Ink}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
