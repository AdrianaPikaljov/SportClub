<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:SportClub.Maui.Services"
             xmlns:vm="clr-namespace:SportClub.Maui.ViewModels"
             x:Class="SportClub.Maui.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Panel}">

    <ScrollView>
        <VerticalStackLayout Padding="28,48,28,40" Spacing="12">
            <Button Text="{loc:T back}" Command="{Binding BackCommand}" HorizontalOptions="Start" BackgroundColor="#262A30"
                    TextColor="{StaticResource OnPanel}" CornerRadius="12" HeightRequest="44" Padding="14,0" FontFamily="OpenSansSemibold" />

            <Label Text="{loc:T register.title}" FontFamily="OpenSansSemibold" FontSize="36" TextColor="{StaticResource OnPanel}" Margin="0,24,0,0" />
            <Label Text="{loc:T register.text}" FontSize="15" TextColor="#B7BCC4" Margin="0,0,0,12" />

            <Label Text="{loc:T register.name}" FontSize="13" TextColor="#B7BCC4" />
            <Border Style="{StaticResource DarkInput}">
                <Entry Text="{Binding FullName}" TextColor="{StaticResource OnPanel}" Placeholder="Mari Tamm" PlaceholderColor="#6E747D" />
            </Border>

            <Label Text="{loc:T login.email}" FontSize="13" TextColor="#B7BCC4" />
            <Border Style="{StaticResource DarkInput}">
                <Entry Text="{Binding Email}" Keyboard="Email" TextColor="{StaticResource OnPanel}" Placeholder="nimi@example.com" PlaceholderColor="#6E747D" />
            </Border>

            <Label Text="{loc:T register.password}" FontSize="13" TextColor="#B7BCC4" />
            <Border Style="{StaticResource DarkInput}">
                <Entry Text="{Binding Password}" IsPassword="True" TextColor="{StaticResource OnPanel}" />
            </Border>

            <Label Text="{loc:T register.confirm}" FontSize="13" TextColor="#B7BCC4" />
            <Border Style="{StaticResource DarkInput}">
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" TextColor="{StaticResource OnPanel}" ReturnCommand="{Binding RegisterCommand}" />
            </Border>

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#FF9C70" FontSize="14" />

            <Button Text="{loc:T register.submit}" Command="{Binding RegisterCommand}" Style="{StaticResource AccentButton}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
