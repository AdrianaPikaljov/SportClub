<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:SportClub.Maui.Converters">

    <conv:InvertBoolConverter x:Key="InvertBool" />

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FullText}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource FullBg}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <Style x:Key="DarkInput" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#1E2126" />
        <Setter Property="Stroke" Value="#3A3F47" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="OkTag" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource OkBg}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="FewTag" TargetType="Border" BasedOn="{StaticResource OkTag}">
        <Setter Property="BackgroundColor" Value="{DynamicResource FewBg}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Panel}" />
        <Setter Property="TextColor" Value="{StaticResource OnPanel}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerBg}" />
        <Setter Property="BorderColor" Value="{DynamicResource DangerBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource FullText}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="BorderColor" Value="{DynamicResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>

    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
